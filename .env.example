# Copy to .env and fill in. Never commit the real file.
#
# The REST API requires an API key/secret pair — a GUI username and password
# returns 401. Create one at System > Access > Users > API keys; the secret is
# shown once and is not recoverable afterwards.

OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=

# Set to 1 for the default self-signed certificate.
OPNSENSE_INSECURE=1
